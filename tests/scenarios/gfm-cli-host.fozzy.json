{
  "version": 1,
  "name": "gfm-cli-host",
  "steps": [
    {
      "type": "proc_spawn",
      "cmd": "target/aarch64-apple-darwin/debug/gfm",
      "args": ["search", ".", "PLAN"],
      "expect_exit": 0
    },
    {
      "type": "proc_spawn",
      "cmd": "target/aarch64-apple-darwin/debug/gfm",
      "args": ["search", ".", "PLAN kind:file ext:md size:>1b"],
      "expect_exit": 0
    },
    {
      "type": "proc_spawn",
      "cmd": "target/aarch64-apple-darwin/debug/gfm",
      "args": ["search", ".", "PLAN modified:>=2020-01-01"],
      "expect_exit": 0
    },
    {
      "type": "proc_spawn",
      "cmd": "target/aarch64-apple-darwin/debug/gfm",
      "args": ["search", ".", "(PLAN OR README) NOT draft kind:file"],
      "expect_exit": 0
    },
    {
      "type": "proc_spawn",
      "cmd": "target/aarch64-apple-darwin/debug/gfm",
      "args": ["search", ".", "tag:Important kind:file"],
      "expect_exit": 0
    },
    {
      "type": "proc_spawn",
      "cmd": "target/aarch64-apple-darwin/debug/gfm",
      "args": ["search", ".", "PLAN scope:/Users/deepsaint/Desktop/gfm"],
      "expect_exit": 0
    },
    {
      "type": "proc_spawn",
      "cmd": "target/aarch64-apple-darwin/debug/gfm",
      "args": ["search-content", ".", "performance-critical"],
      "expect_exit": 0
    },
    {
      "type": "proc_spawn",
      "cmd": "target/aarch64-apple-darwin/debug/gfm",
      "args": ["index", ".", "/tmp/gfm-fozzy-host.gfmidx"],
      "expect_exit": 0
    },
    {
      "type": "proc_spawn",
      "cmd": "target/aarch64-apple-darwin/debug/gfm",
      "args": ["index-content-segment", ".", "/tmp/gfm-fozzy-host.gfmseg"],
      "expect_exit": 0
    },
    {
      "type": "proc_spawn",
      "cmd": "target/aarch64-apple-darwin/debug/gfm",
      "args": [
        "compact-content",
        "/tmp/gfm-fozzy-host.gfmcontent",
        "/tmp/gfm-fozzy-host.gfmseg"
      ],
      "expect_exit": 0
    },
    {
      "type": "proc_spawn",
      "cmd": "target/aarch64-apple-darwin/debug/gfm",
      "args": [
        "search-content-index",
        "/tmp/gfm-fozzy-host.gfmidx",
        "/tmp/gfm-fozzy-host.gfmcontent",
        "performance-critical"
      ],
      "expect_exit": 0
    },
    {
      "type": "proc_spawn",
      "cmd": "target/aarch64-apple-darwin/debug/gfm",
      "args": [
        "search-content-index",
        "/tmp/gfm-fozzy-host.gfmidx",
        "/tmp/gfm-fozzy-host.gfmcontent",
        "\"performance-critical systems\""
      ],
      "expect_exit": 0
    },
    {
      "type": "proc_spawn",
      "cmd": "target/aarch64-apple-darwin/debug/gfm",
      "args": [
        "content-ids",
        "/tmp/gfm-fozzy-host.gfmcontent",
        "performance-critical"
      ],
      "expect_exit": 0
    },
    {
      "type": "proc_spawn",
      "cmd": "target/aarch64-apple-darwin/debug/gfm",
      "args": [
        "index-content-background",
        ".",
        "/tmp/gfm-fozzy-host-segments",
        "/tmp/gfm-fozzy-background.gfmidx",
        "/tmp/gfm-fozzy-background.gfmcontent"
      ],
      "expect_exit": 0
    },
    {
      "type": "proc_spawn",
      "cmd": "target/aarch64-apple-darwin/debug/gfm",
      "args": ["jobs-recover", "/tmp/gfm-jobs.journal"],
      "expect_exit": 0
    },
    {
      "type": "fs_write",
      "path": "tmp/gfm-fozzy-host.icns",
      "data": "icns-test"
    },
    {
      "type": "proc_spawn",
      "cmd": "target/aarch64-apple-darwin/debug/gfm",
      "args": [
        "bundle-app",
        "target/aarch64-apple-darwin/debug/gfm",
        "tmp/gfm-fozzy-host.icns",
        "tmp/gfm-fozzy-dist",
        "--unsigned"
      ],
      "expect_exit": 0
    },
    {
      "type": "proc_spawn",
      "cmd": "target/aarch64-apple-darwin/debug/gfm",
      "args": [
        "notarize-app",
        "tmp/gfm-fozzy-dist/GFM.app",
        "tmp/gfm-fozzy-dist"
      ],
      "expect_exit": 1
    },
    {
      "type": "proc_spawn",
      "cmd": "target/aarch64-apple-darwin/debug/gfm",
      "args": [
        "resume-content-background",
        "/tmp/gfm-content.job",
        "/tmp/gfm-jobs.journal"
      ],
      "expect_exit": 0
    },
    {
      "type": "fs_write",
      "path": "tmp/gfm-fozzy-diagnostics.md",
      "data": "diagnostics needle"
    },
    {
      "type": "proc_spawn",
      "cmd": "target/aarch64-apple-darwin/debug/gfm",
      "args": [
        "diagnostics-index-rebuild",
        "tmp",
        "tmp/gfm-fozzy-diagnostics.gfmidx",
        "tmp/gfm-fozzy-diagnostics.gfmcontent"
      ],
      "expect_exit": 0
    },
    {
      "type": "proc_spawn",
      "cmd": "target/aarch64-apple-darwin/debug/gfm",
      "args": [
        "diagnostics-storage-inspect",
        "tmp/gfm-fozzy-diagnostics.gfmidx"
      ],
      "expect_exit": 0
    },
    {
      "type": "proc_spawn",
      "cmd": "target/aarch64-apple-darwin/debug/gfm",
      "args": [
        "diagnostics-storage-inspect",
        "tmp/gfm-fozzy-diagnostics.gfmcontent"
      ],
      "expect_exit": 0
    },
    {
      "type": "proc_spawn",
      "cmd": "target/aarch64-apple-darwin/debug/gfm",
      "args": [
        "diagnostics-trace-export",
        "tmp/gfm-fozzy-diagnostics-trace.json"
      ],
      "expect_exit": 0
    },
    {
      "type": "proc_spawn",
      "cmd": "target/aarch64-apple-darwin/debug/gfm",
      "args": ["support-check"],
      "expect_exit": 0
    },
    {
      "type": "proc_spawn",
      "cmd": "target/aarch64-apple-darwin/debug/gfm",
      "args": [
        "diagnostics-parity-baseline",
        "tmp/gfm-fozzy-config.toml",
        "tmp/baselines",
        "25A354"
      ],
      "expect_exit": 0
    }
  ]
}
